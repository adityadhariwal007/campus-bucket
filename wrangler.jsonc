{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "campus-bucket",
  "account_id": "8e07b2aef03bf12ea0b6dc6cc5140fed",
  "main": "worker.ts",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "routes": [
    {
      "pattern": "campusbucket.live/*",
      "zone_name": "campusbucket.live",
    },
    {
      "pattern": "www.campusbucket.live/*",
      "zone_name": "campusbucket.live",
    },
  ],
  "ratelimits": [
    {
      "name": "BUCK_LIMITER",
      "namespace_id": "1001003",
      "simple": { "limit": 8, "period": 60 },
    },
    {
      "name": "ACCOUNT_LIMITER",
      "namespace_id": "1001002",
      "simple": { "limit": 5, "period": 60 },
    },
    {
      "name": "SITE_LIMITER",
      "namespace_id": "1001001",
      "simple": {
        "limit": 300,
        "period": 60,
      },
    },
  ],
}
